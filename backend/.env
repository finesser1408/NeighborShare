# NeighbourShare Development Environment
# ========================================
# Copy this file and customise values for your environment.
# NEVER commit real secrets to version control.

DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-me-in-production-abc123xyz

# Database (matches docker-compose defaults)
POSTGRES_DB=neighbourshare
POSTGRES_USER=neighbourshare
POSTGRES_PASSWORD=neighbourshare
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# EcoCash (sandbox)
ECOCASH_API_URL=https://sandbox.ecocash.co.zw/api/v2
ECOCASH_MERCHANT_ID=
ECOCASH_API_KEY=
ECOCASH_WALLET_LIMIT=50000

# Nominatim
NOMINATIM_USER_AGENT=NeighbourShare/1.0

# Django
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Site URL (used for EcoCash callbacks)
SITE_URL=http://localhost:8000

# GDAL / GEOS paths (uncomment and configure if running Django locally on Windows instead of Docker)
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal308.dll
# GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll

# Set to True to use standard SQLite database for easy local development without PostgreSQL/PostGIS setup
USE_SQLITE=True


